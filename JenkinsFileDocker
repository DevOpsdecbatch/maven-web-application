pipeline {

    agent any

    tools
        {
            maven 'Maven_3.9.9'
        }

    environment
        {
            buildNumber = "${BUILD_NUMBER}"
        }
    stages
    {

        stage('Checkout code from GitHub')
        {
            steps()
            {
                git branch: 'DevOpsPractice', url: 'https://github.com/DevOpsdecbatch/maven-web-application.git'
            }
        }
        stage('Build Maven Package')
        {
            steps()
            {
                sh 'mvn clean package'
            }
        }
        stage('Build Docker Image')
        {
            steps()
            {
                sh 'docker build -t soumyarajakumar/mavenapplication:$buildNumber .'
            }
        }
          stage('Push Docker Image to DockerHub')
        {
            steps()
            {
                withCredentials([string(credentialsId: 'DockerHub_Password', variable: 'DockerHub_Password')]) 
                {
                    sh 'docker login -u soumyarajakumar -p $DockerHub_Password'
                }
                sh 'docker push soumyarajakumar/mavenapplication:$buildNumber'
            }
        }

        stage('Remove Docker Image from Local')
        {
            steps()
            {
                sh 'docker rmi soumyarajakumar/mavenapplication:$buildNumber'
            }
        }

        stage('Deploy Application to Docker Deployment Server')
        {
            steps()
            {
                sshagent(['DeploymentServer_SSH']) 
                {
                    sh 'ssh -o StrictHostKeyChecking=no ubuntu@98.130.124.83 docker rm -f maven-container || true'
                    sh 'ssh -o StrictHostKeyChecking=no ubuntu@98.130.124.83 docker run -d --name maven-container -p 8080:8080 soumyarajakumar/mavenapplication:$buildNumber'
                }
            }
        }
    }
}
